# Copy to .env and fill in real values. Never commit .env.

# LLM provider
ANTHROPIC_API_KEY=
COHERE_API_KEY=
# Optional — defaults to command-a-03-2025
# COHERE_MODEL=

# LangSmith
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# Only needed if your LangSmith workspace is on the EU region (check the
# quickstart panel on smith.langchain.com) — otherwise omit this line.
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# n8n
N8N_API_KEY=
N8N_WEBHOOK_URL=

# Data source(s)
DATA_SOURCE_API_KEY=
